SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...
CANVAS_IDS=F0123456789,F0987654321
STATE_FILE_PATH=/data/state.json
PREFERENCES_FILE_PATH=/data/preferences.json
WATCHERS_FILE_PATH=/data/watchers.json
TIMEZONE=UTC
DAILY_CLEANUP_HOUR=4
DAILY_CLEANUP_MINUTE=0
DEFAULT_LOCALE=ru

# Optional liveness heartbeat (Uptime Kuma "push" monitor URL). The bot GETs it
# every HEARTBEAT_INTERVAL_SECONDS; leave empty to disable.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SECONDS=60
